
# Terraform working directory and providers
**/.terraform/*
.terraform/
.terraform.lock.hcl

# Terraform state and backups
*.tfstate
*.tfstate.*
*.tfstate.backup
terraform/backups/

# Terraform plans and crash logs
*.tfplan
crash.log
crash.*.log

# Variable files may contain secrets
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local environment and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
kubeconfig
kubeconfig.*
*-kubeconfig

# Ansible
ansible/*.retry
ansible/**/.ansible/

# SSH private keys
id_rsa
id_ed25519
spacelab

# Editor and operating system files
.vscode/
.idea/
.DS_Store
*~
*.swp
*.swo
